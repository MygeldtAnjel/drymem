__pycache__/
*.pyc
.venv/
.env
*.sqlite*

.roo/*
.claude/*
.mcp.json

# uv creates a venv per project dir
apps/server/.venv/
node_modules/
apps/cli/dist/
apps/api/dist/
apps/landing/dist/
*.tsbuildinfo

# Working files. The lockfile is a cache, not a record: the server decides which
# skills a project uses, because that is what the web UI edits. A copy in git is
# a second source of truth that goes stale the moment an admin clicks Add, and
# that rewrites itself in every teammate's working tree at their next session.
.drymem/drafts/
.drymem/skills.lock

# Installed skills are generated by `drymem skills pull`, from the server.
# Committing them would put the same content in the repo twice and let the two
# drift; the lockfile and its hashes are the record.
.opencode/skill/
.cursor/rules/*.drymem.mdc

# Review captures are regenerated; the design records are not
.impeccable/review/
backups/

# Working notes from the design tooling, not part of the product.
.impeccable/

# Planning and strategy: kept locally, deliberately not published.
PLAN.md
docs/specs/
docs/PLAN-v1.md

# The console's build output. The Docker image builds it itself; committing it
# means every `vite build` leaves a dirty tree and every review carries a
# minified diff nobody reads.
apps/server/drymem_server/web/

# Copied in by the CLI's prepack, so the tarball carries them — never edited here.
apps/cli/skills/
apps/cli/LICENSE
apps/cli/NOTICE
apps/cli/*.tgz

# Recordings from `make tour` — regenerate them, do not commit them.
/tour/
