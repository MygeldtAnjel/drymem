__pycache__/
*.pyc
.venv/
.env
*.sqlite*

.roo/*
.claude/*
.mcp.json

# uv creates a venv per project dir
apps/server/.venv/
node_modules/
apps/cli/dist/
apps/api/dist/
apps/landing/dist/
*.tsbuildinfo

# Working files. The lockfile is a cache, not a record: the server decides which
# skills a project uses, because that is what the web UI edits. A copy in git is
# a second source of truth that goes stale the moment an admin clicks Add, and
# that rewrites itself in every teammate's working tree at their next session.
.drymem/drafts/
.drymem/skills.lock

# Installed skills are generated by `drymem skills pull`, from the server.
# Committing them would put the same content in the repo twice and let the two
# drift; the lockfile and its hashes are the record.
.opencode/skill/
.cursor/rules/*.drymem.mdc

# Review captures are regenerated; the design records are not
.impeccable/review/
backups/
