{
  "openapi": "3.1.0",
  "info": {
    "title": "drymem",
    "description": "Shared long-term memory for AI coding agents.\n\nEvery memory belongs to a project, identified by its normalised git remote, and\nto the person who saved it. Memories are private until explicitly promoted.",
    "version": "2.1.0"
  },
  "paths": {
    "/v1/memories": {
      "post": {
        "tags": [
          "memories"
        ],
        "summary": "Save Memory",
        "description": "Save a session summary. Returns 422 if it contains a private key.",
        "operationId": "save_memory_v1_memories_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveMemoryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveMemoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/memories/{topic_key}": {
      "patch": {
        "tags": [
          "memories"
        ],
        "summary": "Update Memory",
        "description": "Append to a topic, or replace it.\n\nAppending is the default because Graphiti reconciles contradictions itself:\nthe older fact is marked superseded rather than lost, which keeps the history\nof a decision readable.",
        "operationId": "update_memory_v1_memories__topic_key__patch",
        "parameters": [
          {
            "name": "topic_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Topic Key"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMemoryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveMemoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/memories/search": {
      "get": {
        "tags": [
          "memories"
        ],
        "summary": "Search Memories",
        "operationId": "search_memories_v1_memories_search_get",
        "parameters": [
          {
            "name": "project_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Key"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Q"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/memories/context": {
      "get": {
        "tags": [
          "memories"
        ],
        "summary": "Memory Context",
        "operationId": "memory_context_v1_memories_context_get",
        "parameters": [
          {
            "name": "project_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Key"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/memories/{episode_uuid}": {
      "delete": {
        "tags": [
          "memories"
        ],
        "summary": "Delete Memory",
        "description": "Delete a memory. A uuid outside the caller's org is simply not found.",
        "operationId": "delete_memory_v1_memories__episode_uuid__delete",
        "parameters": [
          {
            "name": "episode_uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Episode Uuid"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "List Projects",
        "operationId": "list_projects_v1_projects_get",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Healthz",
        "description": "Liveness for both stores. Unauthenticated on purpose \u2014 it reveals nothing.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContextResponse": {
        "properties": {
          "project_key": {
            "type": "string",
            "title": "Project Key"
          },
          "episodes": {
            "items": {
              "$ref": "#/components/schemas/EpisodeOut"
            },
            "type": "array",
            "title": "Episodes"
          }
        },
        "type": "object",
        "required": [
          "project_key",
          "episodes"
        ],
        "title": "ContextResponse"
      },
      "DeleteResponse": {
        "properties": {
          "episode_uuid": {
            "type": "string",
            "title": "Episode Uuid"
          },
          "deleted": {
            "type": "boolean",
            "title": "Deleted"
          }
        },
        "type": "object",
        "required": [
          "episode_uuid",
          "deleted"
        ],
        "title": "DeleteResponse"
      },
      "EpisodeOut": {
        "properties": {
          "uuid": {
            "type": "string",
            "title": "Uuid"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": "private"
          }
        },
        "type": "object",
        "required": [
          "uuid",
          "name",
          "content"
        ],
        "title": "EpisodeOut"
      },
      "FactOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "fact": {
            "type": "string",
            "title": "Fact"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "superseded": {
            "type": "boolean",
            "title": "Superseded",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "name",
          "fact"
        ],
        "title": "FactOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "postgres": {
            "type": "boolean",
            "title": "Postgres"
          },
          "neo4j": {
            "type": "boolean",
            "title": "Neo4J"
          },
          "extractor": {
            "type": "string",
            "title": "Extractor"
          }
        },
        "type": "object",
        "required": [
          "status",
          "postgres",
          "neo4j",
          "extractor"
        ],
        "title": "HealthResponse"
      },
      "ProjectOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "project_key": {
            "type": "string",
            "title": "Project Key"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "memory_count": {
            "type": "integer",
            "title": "Memory Count",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "id",
          "project_key"
        ],
        "title": "ProjectOut"
      },
      "ProjectsResponse": {
        "properties": {
          "projects": {
            "items": {
              "$ref": "#/components/schemas/ProjectOut"
            },
            "type": "array",
            "title": "Projects"
          }
        },
        "type": "object",
        "required": [
          "projects"
        ],
        "title": "ProjectsResponse"
      },
      "SaveMemoryRequest": {
        "properties": {
          "project_key": {
            "type": "string",
            "title": "Project Key",
            "description": "Normalised git remote, e.g. github.com/acme/payments"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "title": "Summary",
            "description": "Markdown body written by the agent"
          },
          "topic_key": {
            "type": "string",
            "title": "Topic Key",
            "description": "Stable key for cross-session linking",
            "default": ""
          },
          "tool": {
            "type": "string",
            "title": "Tool",
            "description": "Which agent produced this",
            "default": "claude-code"
          }
        },
        "type": "object",
        "required": [
          "project_key",
          "summary"
        ],
        "title": "SaveMemoryRequest"
      },
      "SaveMemoryResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "episode_uuid": {
            "type": "string",
            "title": "Episode Uuid"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "project_key": {
            "type": "string",
            "title": "Project Key"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "entity_count": {
            "type": "integer",
            "title": "Entity Count"
          },
          "relationship_count": {
            "type": "integer",
            "title": "Relationship Count"
          },
          "scrubbed": {
            "type": "string",
            "title": "Scrubbed",
            "description": "What was redacted, empty if nothing",
            "default": ""
          },
          "degraded": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Degraded",
            "description": "Set when extraction failed and only the episode was stored"
          }
        },
        "type": "object",
        "required": [
          "id",
          "episode_uuid",
          "name",
          "project_key",
          "author",
          "entity_count",
          "relationship_count"
        ],
        "title": "SaveMemoryResponse"
      },
      "SearchResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "project_key": {
            "type": "string",
            "title": "Project Key"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/FactOut"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "query",
          "project_key",
          "results"
        ],
        "title": "SearchResponse"
      },
      "UpdateMemoryRequest": {
        "properties": {
          "project_key": {
            "type": "string",
            "title": "Project Key"
          },
          "update_summary": {
            "type": "string",
            "minLength": 1,
            "title": "Update Summary"
          },
          "replace": {
            "type": "boolean",
            "title": "Replace",
            "description": "Delete prior episodes for this topic first",
            "default": false
          },
          "tool": {
            "type": "string",
            "title": "Tool",
            "default": "claude-code"
          }
        },
        "type": "object",
        "required": [
          "project_key",
          "update_summary"
        ],
        "title": "UpdateMemoryRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
