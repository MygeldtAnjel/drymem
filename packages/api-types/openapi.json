  "components": {
    "schemas": {
      "ClusterOut": {
        "properties": {
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "memory_count": {
            "type": "integer",
            "title": "Memory Count"
          },
          "facts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Facts",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "topic",
          "memory_count"
        ],
        "title": "ClusterOut"
      },
      "ContextResponse": {
        "properties": {
          "project_key": {
            "type": "string",
            "title": "Project Key"
          },
          "episodes": {
            "items": {
              "$ref": "#/components/schemas/EpisodeOut"
            },
            "type": "array",
            "title": "Episodes"
          }
        },
        "type": "object",
        "required": [
          "project_key",
          "episodes"
        ],
        "title": "ContextResponse"
      },
      "DeleteResponse": {
        "properties": {
          "episode_uuid": {
            "type": "string",
            "title": "Episode Uuid"
          },
          "deleted": {
            "type": "boolean",
            "title": "Deleted"
          }
        },
        "type": "object",
        "required": [
          "episode_uuid",
          "deleted"
        ],
        "title": "DeleteResponse"
      },
      "DiscoverResponse": {
        "properties": {
          "project_key": {
            "type": "string",
            "title": "Project Key"
          },
          "clusters": {
            "items": {
              "$ref": "#/components/schemas/ClusterOut"
            },
            "type": "array",
            "title": "Clusters"
          }
        },
        "type": "object",
        "required": [
          "project_key",
          "clusters"
        ],
        "title": "DiscoverResponse"
      },
      "DistillRequest": {
        "properties": {
          "project_key": {
            "type": "string",
            "title": "Project Key"
          },
          "topic": {
            "type": "string",
            "minLength": 1,
            "title": "Topic"
          }
        },
        "type": "object",
        "required": [
          "project_key",
          "topic"
        ],
        "title": "DistillRequest"
      },
      "DistillResponse": {
        "properties": {
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "memory_count": {
            "type": "integer",
            "title": "Memory Count"
          }
        },
        "type": "object",
        "required": [
          "topic",
          "name",
          "content",
          "model",
          "memory_count"
        ],
        "title": "DistillResponse"
      },
      "EpisodeOut": {
        "properties": {
          "uuid": {
            "type": "string",
            "title": "Uuid"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": "private"
          }
        },
        "type": "object",
        "required": [
          "uuid",
          "name",
          "content"
        ],
        "title": "EpisodeOut"
      },
      "FactOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "fact": {
            "type": "string",
            "title": "Fact"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "superseded": {
            "type": "boolean",
            "title": "Superseded",
            "default": false
          }
        },
