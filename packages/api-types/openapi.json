                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/memories/{episode_uuid}/promote": {
      "post": {
        "tags": [
          "memories"
        ],
        "summary": "Promote Memory",
        "description": "Share a memory with the project's members.\n\nOnly your own memory, and only into a project you belong to. Promoting an\nalready-promoted memory succeeds without duplicating it, so a retry is safe.",
        "operationId": "promote_memory_v1_memories__episode_uuid__promote_post",
        "parameters": [
          {
            "name": "episode_uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Episode Uuid"
