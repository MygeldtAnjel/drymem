    "/v1/skills/discover": {
      "get": {
        "tags": [
          "skills"
        ],
        "summary": "Discover Skills",
        "description": "Subjects the team's memories keep returning to.\n\nWhich of them lack a skill is decided by the client, which is the only side\nthat knows what is installed on this machine.",
        "operationId": "discover_skills_v1_skills_discover_get",
        "parameters": [
          {
            "name": "project_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Key"
            }
          },
          {
            "name": "min_memories",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 2,
              "title": "Min Memories"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
