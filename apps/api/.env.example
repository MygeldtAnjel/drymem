# The control plane. Copy to the repo root .env; nothing here is committed.

# Shared with the Python engine, which verifies the assertions this app signs.
# Any long random string; both services must agree.
SERVICE_SECRET=change-me-to-32-random-characters

# Where people reach the UI. Used for the links inside invitations and resets,
# so it has to be an address the recipient can actually open.
PUBLIC_URL=http://127.0.0.1:8080

# On behind TLS, off on a laptop over http.
COOKIE_SECURE=false

# Resend. Leave empty and every invitation and reset link is still created and
# still returned to the person who asked for it — which is the only thing that
# works on a machine with no mail server.
RESEND_API_KEY=
EMAIL_FROM="drymem <onboarding@resend.dev>"
