  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Identical bytes are the same version",
      "items": [
        "Publishing twice by accident returns `unchanged` and adds nothing to the history",
        "A newer version does not move a project: its lead updates the pin"
      ]
    },
    {
      "dot": "emerald",
      "title": "Only an org admin can import from outside",
      "items": [
        "An imported skill runs on every laptop on the project; that is an organisation decision, not a project one"
      ]
    }
  ]
}