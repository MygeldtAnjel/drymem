{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "A skill's states",
    "viewBox": [
      980,
      640
    ],
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main",
        "label": "From draft to installed",
        "focus": [
          "draft",
          "scanned",
          "published",
          "enabled"
        ],
        "note": "The happy path. Every published version is pinned by sha, so a project stays on what it chose."
      },
      {
        "id": "gates",
        "label": "Where it stops",
        "focus": [
          "scanned",
          "rejected",
          "pending",
          "published"
        ],
        "note": "A credential ends it. Anything the scanner flags waits for a human."
      },
      {
        "id": "end",
        "label": "Retiring one",
        "focus": [
          "enabled",
          "removed",
          "deprecated"
        ],
        "note": "Deprecating stops new enables; projects already on it keep working. Removing from a project deletes it at the next session."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Catalogue phases"
    },
    {
      "id": "review",
      "label": "Waiting on an admin"
    },
    {
      "id": "terminal",
      "label": "Terminal exits"
    }
  ],
  "states": [
    {
      "id": "draft",
      "type": "start",
      "label": "Draft",
      "sublabel": "distill · author · import",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "not installed"
    },
    {
      "id": "scanned",
      "type": "decision",
      "label": "Scanned",
      "sublabel": "secrets? findings?",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "gate"
    },
    {
      "id": "published",
      "type": "active",
      "label": "Published",
      "sublabel": "version n · sha256",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "topics tagged"
    },
    {
      "id": "enabled",
      "type": "success",
      "label": "Enabled",
      "sublabel": "pinned per project",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "pulled at start"
    },
    {
      "id": "removed",
      "type": "neutral",
      "label": "Removed",
      "sublabel": "disabled on project",
      "lane": "main",
      "col": 4,
      "step": "05",
      "tag": "deleted next session"
    },
    {
      "id": "pending",
      "type": "waiting",
