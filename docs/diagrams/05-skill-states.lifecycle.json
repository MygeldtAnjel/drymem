      "col": 0,
      "tag": "terminal"
    },
    {
      "id": "deprecated",
      "type": "neutral",
      "label": "Deprecated",
      "sublabel": "no new enables",
      "lane": "terminal",
      "col": 1,
      "tag": "terminal"
    }
  ],
  "transitions": [
    {
      "from": "scanned",
      "to": "pending",
      "label": "findings",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "left",
      "labelSegment": 1
    },
    {
      "from": "pending",
      "to": "published",
      "label": "approve",
      "variant": "default",
      "fromSide": "top",
      "toSide": "bottom",
      "route": "straight"
    },
    {
      "from": "scanned",
      "to": "rejected",
      "label": "credential",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "channelY": 356,
      "labelDy": 41
    },
    {
      "from": "enabled",
