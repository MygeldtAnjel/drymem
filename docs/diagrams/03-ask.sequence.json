{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Chat — a grounded answer with citations",
    "viewBox": [1080, 600],
    "column_fit": "spread",
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      { "id": "retrieval", "label": "What the model is allowed to see", "focus": ["engine", "neo4j", "postgres"],
        "note": "Graph facts and full-text episodes, scored together, over exactly the groups this caller may read. Nothing else reaches the prompt." },
      { "id": "grounding", "label": "Every claim points at a memory", "focus": ["engine", "ollama", "api"],
        "note": "Four memories at most. Only the ones the model cited come back, renumbered from one; a marker pointing at nothing is dropped." },
      { "id": "conversation", "label": "It is a conversation", "focus": ["browser", "api", "postgres"],
        "note": "The API sends the last turns and the uuids the previous answer cited, so “and why?” means something. Order is by seq, not time." }
    ]
  },
  "participants": [
    { "id": "browser",  "type": "frontend", "label": "Chat page",   "sublabel": "React" },
    { "id": "api",      "type": "security", "label": "API",         "sublabel": "/v1/chats/ask" },
    { "id": "engine",   "type": "backend",  "label": "Engine",      "sublabel": "/v1/ask" },
    { "id": "neo4j",    "type": "database", "label": "Neo4j",       "sublabel": "scoped search" },
    { "id": "postgres", "type": "database", "label": "Postgres",    "sublabel": "names · chats" },
    { "id": "ollama",   "type": "cloud",    "label": "Local model", "sublabel": "no reasoning" }
  ],
  "segments": [
    { "from": 150, "to": 245, "label": "Ask" },
    { "from": 255, "to": 345, "label": "Retrieve" },
    { "from": 355, "to": 420, "label": "Answer" },
    { "from": 430, "to": 530, "label": "Keep" }
  ],
  "messages": [
    { "id": "a1",  "from": "browser",  "to": "api",      "y": 170, "label": "POST /v1/chats/ask",         "variant": "emphasis" },
    { "id": "a2",  "from": "api",      "to": "postgres", "y": 200, "label": "last turns + carried uuids", "variant": "default" },
    { "id": "a3",  "from": "api",      "to": "engine",   "y": 230, "label": "POST /v1/ask · principal",   "variant": "security" },
    { "id": "a4",  "from": "engine",   "to": "neo4j",    "y": 270, "label": "facts + fulltext, own groups", "variant": "emphasis" },
    { "id": "a5",  "from": "neo4j",    "to": "engine",   "y": 300, "label": "candidates → score → top 4", "variant": "return" },
    { "id": "a6",  "from": "engine",   "to": "postgres", "y": 330, "label": "author names",               "variant": "default" },
    { "id": "a7",  "from": "engine",   "to": "ollama",   "y": 370, "label": "rules + 4 memories + turns", "variant": "emphasis" },
    { "id": "a8",  "from": "ollama",   "to": "engine",   "y": 400, "label": "answer with [n] markers",    "variant": "return" },
    { "id": "a9",  "from": "engine",   "to": "api",      "y": 440, "label": "200 {answer, cited sources}", "variant": "return" },
    { "id": "a10", "from": "api",      "to": "postgres", "y": 470, "label": "INSERT messages (seq)",      "variant": "emphasis" },
    { "id": "a11", "from": "api",      "to": "browser",  "y": 510, "label": "message + source cards",     "variant": "return" }
  ],
  "activations": [
    { "participant": "api",    "from": 165, "to": 515, "type": "security" },
    { "participant": "engine", "from": 225, "to": 445, "type": "backend" }
  ],
  "cards": [
    { "dot": "emerald", "title": "Scoring and grounding", "items": [
      "readable_groups = team + own, org-scoped. Score: graph hit +3, carried from last answer +2, word match +1; top 4 go to the model",
      "Only cited memories return, renumbered from 1; a dangling [n] is dropped",
      "Nothing matches → no model call; grounded: false is stored on the message" ] },
    { "dot": "amber", "title": "Measured, not assumed", "items": [
      "`make eval` runs real questions against the real model and grades every prompt rule",
      "It caught a refusal caused by showing an email instead of a name, and a [5] with one card under it" ] }
  ]
}
