        "focus": [
          "written",
          "scrubbed",
          "refused"
        ],
        "note": "A private-key block fails the save and is audited. Everything else is redacted and kept — blocking teaches people to stop saving."
      },
      {
        "id": "later",
        "label": "Getting old, and going",
        "focus": [
          "shared",
          "superseded",
          "deleted"
        ],
        "note": "A later memory that contradicts an earlier one marks it superseded. Delete removes both copies and the index row."
      }
