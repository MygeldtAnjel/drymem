  "cards": [
    {
      "dot": "rose",
      "title": "The two guarantees",
      "items": [
        "Scrub before store or model: a stored secret is searchable, shared on promotion, and fed back into prompts",
        "Commit before reply: the 40ms teardown-commit race made sharing a coin flip until it was moved"
      ]
    },
    {
      "dot": "emerald",
      "title": "Details the arrows leave out",
      "items": [
        "ensure_project: the first save in a repo creates the project; the saver becomes lead",
        "scope=private, session id and topic_key go on the index row; the text goes only to Neo4j",
        "If extraction fails the episode is still saved and the reply says degraded: true"
      ]
    }
  ]
