# Copy to `.env` and fill in. `docker compose` reads this file automatically.
#
# Only SERVICE_SECRET has no default — everything else below is already the
# value compose would use, written out so you can see what you are running.

# ---- required ----------------------------------------------------------------

# Signs the short-lived principal the API mints for each call into the memory
# engine. The engine authenticates nobody; it trusts this signature and nothing
# else, so a shared or leaked value is a way into every organisation's memory.
# Generate one per install and never commit it:
#
#   openssl rand -hex 32
#
# ---- the databases ----------------------------------------------------------
#
# drymem keeps two: Postgres for the index — who wrote what, when, what it was
# rated — and Neo4j for the memory text itself. Either can run here in a
# container or be one you already have.
#
# COMPOSE_PROFILES lists the ones to run here. Leave a profile out and set the
# matching URL below to point at a managed database instead. Postgres appears
# twice because the engine speaks asyncpg and the API speaks libpq.
COMPOSE_PROFILES=bundled-neo4j,bundled-postgres
DATABASE_URL=
API_DATABASE_URL=
NEO4J_URI=
NEO4J_USER=neo4j

# Generated by scripts/install.sh for a database it starts; for a managed one,
# the password it already has. The compose file falls back to a well-known
# development value so a fresh clone still starts.
POSTGRES_PASSWORD=
NEO4J_PASSWORD=

SERVICE_SECRET=

# ---- where it is reachable ---------------------------------------------------

# The address people type. It is what invitation and password-reset links are
# built from, so a wrong value sends everyone to a page that does not exist.
PUBLIC_URL=http://127.0.0.1:8080

# Set to true behind HTTPS. Session cookies are `Secure` when it is, which
# means they stop working over plain http — deliberately.
COOKIE_SECURE=false

# ---- the model that does the extracting --------------------------------------

# `ollama` runs it on this machine; `openai` sends memories to OpenAI. The
# default is local because a memory store is the last thing most teams want to
# post to a third party.
DRYMEM_EXTRACTOR=ollama
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3.6:35b-a3b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Embeddings need not come from where the reasoning does, and are never
# optional — everything stored gets one. Empty means they follow LOCAL_LLM_URL
# with no key, which is what an Ollama wants. Set both to use a hosted
# provider, which is what makes a machine with no GPU a complete deployment.
EMBEDDING_URL=
EMBEDDING_API_KEY=

# ---- email -------------------------------------------------------------------

# Invitations, password resets and the notice that a password changed. Leaving
# it empty is supported: the link is always returned to the admin who created
# it, so nothing is blocked on mail being configured (D42).
#
# The default sender is Resend's shared test address, which delivers ONLY to the
# address that owns the Resend account. That is enough to see your own reset
# email and no use at all for inviting a teammate — for that, verify a domain at
# resend.com/domains and set EMAIL_FROM to something on it.
RESEND_API_KEY=
EMAIL_FROM=drymem <onboarding@resend.dev>

# Where "somebody asked for access" goes. Defaults to the sender's own address.
ACCESS_REQUESTS_TO=

# The marketing site's origin, e.g. https://drymem.dev. Set only when the
# landing page is deployed somewhere other than this server: its request-access
# form is the one cross-origin call in the product, and nothing else is allowed.
LANDING_ORIGIN=

# ---- signing in with GitHub --------------------------------------------------

# Optional, and off unless both are set. Every user of this product is a
# developer with a GitHub account, and it removes a password from their life —
# but it is a second door, not the only one, so password login keeps working.
#
# Register an OAuth app at https://github.com/settings/developers with the
# callback set to <PUBLIC_URL>/auth/github/callback.
#
# It signs people in; it does not let them in. A GitHub identity is matched
# against an account that already exists, by verified primary email. Somebody
# with no account is told to ask for an invitation.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- extra redaction ---------------------------------------------------------

# Comma-separated literals the scrubber removes on top of the patterns it
# already knows. Internal hostnames and customer names belong here.
SCRUB_DENYLIST=
